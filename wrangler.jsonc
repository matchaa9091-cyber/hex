{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hex",
  "account_id": "5bd6b605fed307126be13ca359f03fae",
  "main": "worker-entry.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hex"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "hex-opennext-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CACHE_GENERATION",
        "class_name": "CacheGeneration"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cache-generation-v1",
      "new_sqlite_classes": ["CacheGeneration"]
    }
  ],
  "routes": [
    { "pattern": "www.hexescortsug.com", "custom_domain": true },
    { "pattern": "hexescortsug.com", "custom_domain": true }
  ],
  // Secrets (CLOUDFLARE_D1_TOKEN, CLOUDFLARE_R2_ACCESS_KEY_ID,
  // CLOUDFLARE_R2_SECRET_ACCESS_KEY, HTTPSMS_API_KEY) are stored with
  // `wrangler secret put` and must never be committed here.
  "vars": {
    "CLOUDFLARE_D1_ACCOUNT_ID": "b07234f65853d0f9f8e6fa1896cf06db",
    "CLOUDFLARE_D1_DATABASE_ID": "9914bf44-9661-4a24-903f-d49c73d6b1fe",
    "CLOUDFLARE_R2_BUCKET": "hexescorts-media",
    "CLOUDFLARE_R2_PUBLIC_URL": "https://pub-aa01e6dca81f482ab084275e93025a99.r2.dev",
    "CLOUDFLARE_R2_ENDPOINT": "https://b07234f65853d0f9f8e6fa1896cf06db.r2.cloudflarestorage.com",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_mZ8uHWbdAi4Xb96cwAeJG2HAxv9s6fKzbVf6THbpAmL7",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "HTTPSMS_PHONE_NUMBER": "+256765040502"
  }
}
